# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/imovies_db

# Authentication
JWT_SECRET=imovies_dev_jwt_secret_key_1234567890_super_secure
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=imovies_dev_jwt_refresh_secret_key_0987654321_secure
JWT_REFRESH_EXPIRES_IN=7d

# Payment Configuration (development mock mode)
PAYMENT_PROVIDER=dev_mock
PAYMENT_KEY_ID=mock_dev_key_imovies
PAYMENT_KEY_SECRET=mock_dev_secret_imovies
PAYMENT_WEBHOOK_SECRET=mock_dev_webhook_imovies

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=500
