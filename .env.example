# ==============================================================================
# IMOVIES - APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in the root or server directory for local development.
# Do NOT commit actual secrets or production credentials to source control.

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/imovies_db

# Authentication & Security
JWT_SECRET=your_jwt_access_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Payment Integration (dev_mock, stripe, or razorpay)
PAYMENT_PROVIDER=dev_mock
PAYMENT_KEY_ID=mock_key_id_placeholder
PAYMENT_KEY_SECRET=mock_key_secret_placeholder
PAYMENT_WEBHOOK_SECRET=mock_webhook_secret_placeholder

# File Storage & Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Email Service (Optional for development notifications)
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_user_placeholder
EMAIL_PASS=your_mailtrap_pass_placeholder
EMAIL_FROM=noreply@imovies.local

# Rate Limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=200
