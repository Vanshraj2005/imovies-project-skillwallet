{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies - Full-Stack Movie Ticket Booking & Cinema Management Platform (MERN)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "seed": "npm --prefix server run seed",
    "start": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "test": "npm run test:server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
